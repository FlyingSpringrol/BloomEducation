  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The Nile River was the lifeblood of Egyptian society. \n\nEvery year,
    the river would flood, leaving behind fertile soil where the Egyptians could
    plant crops like barley, wheat and flax. \n\n"
  m_isRightToLeft: 0
