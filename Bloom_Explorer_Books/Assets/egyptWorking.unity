      m_Calls: []
  m_text: "Here we see a slaughterhouse. Scenes like this were recorded by the Egyptians
    into tomb paintings and wooden models, and occasionally placed into tombs. \n\nThe
    Egyptians believed that doing so would allow these workers to follow the buried
    person into the afterlife and continue their work for them.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 756a8c9b083f04819b8b1c63c736172c, type: 2}
