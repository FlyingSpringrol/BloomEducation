  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The Egyptians often depicted their gods with the heads of animals, and
    told stories about how they influenced the world. \n\nThere was a myth in which
    Sobek, the crocodile headed god, laid eggs by the Nile that would eventually
    give birth to the universe. Normally he was shown as a violent god with the traits
    of a crocodile, but every god had their complexities.\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 756a8c9b083f04819b8b1c63c736172c, type: 2}
  m_sharedMaterial: {fileID: -633874113913258559, guid: 756a8c9b083f04819b8b1c63c736172c,
