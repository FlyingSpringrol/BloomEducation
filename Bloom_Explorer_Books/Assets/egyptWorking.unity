  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The Egyptians invented many techniques for weaving linens together. The
    upper class wore more transparent linens, while the lower class wore thicker
    fabrics. Generally these types of clothing were made from flax plant. \n\nSimilar
    to the slaughterhouse scene, the Egyptians recorded the lives of weavers into
    paintings and models, so the workers could follow the buried into the afterlife.
    There are many wooden models of day to day life in Egypt due to to this belief.
    \n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 756a8c9b083f04819b8b1c63c736172c, type: 2}
  m_sharedMaterial: {fileID: -633874113913258559, guid: 756a8c9b083f04819b8b1c63c736172c,
