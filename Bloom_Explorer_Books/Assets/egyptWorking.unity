  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "This is a tomb painting of butchers working in ancient Egypt. \n\nMuch
    of what we know about the ancient Egyptians comes from these stylized drawings
    that were engraved, then painted in tombs to be discovered thousands of years
    later."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 756a8c9b083f04819b8b1c63c736172c, type: 2}
