  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The Egyptians believed that after death the soul would pass through the
    Hall of Truth, where Anubis and the other gods of the underworld would weigh
    the heart next to the sacred feather of Ma\u2019at. They believed the heart held
    all the good and bad that a person had done during their lifetime.\n\nIf the
    heart was lighter than the feather, the soul would be allowed to pass into paradise,
    where they would be reunited with all their possessions from the material world.
    If not, the heart would be devoured and the soul would simply cease to exist."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 756a8c9b083f04819b8b1c63c736172c, type: 2}
