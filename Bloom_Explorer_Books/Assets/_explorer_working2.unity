  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The largest predator during the Cambrian was Anomalocaris. It was an athropod
    (like a spider or a lobster).\n\n It swam using its side fins, grabbing it's
    food with it's evolved mouth parts and slurping them up with it's circular mouth
    hole."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 756a8c9b083f04819b8b1c63c736172c, type: 2}
