    m_TypeName: UnityEngine.UI.MaskableGraphic+CullStateChangedEvent, UnityEngine.UI,
      Version=1.0.0.0, Culture=neutral, PublicKeyToken=null
  m_FontData:
    m_Font: {fileID: 12800000, guid: 1661911a063af41dd9de29a01f7f9457, type: 3}
    m_FontSize: 50
    m_FontStyle: 0
    m_BestFit: 1
    m_MinSize: 0
    m_MaxSize: 50
    m_Alignment: 1
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "Here we see schools of Marella swim through the water. Marella were some
    of the most common organisms that lived during the Cambrian.\n\nThe scientist,
    Dr. John Walcott, who first discovered the fossils, named them Marella Splendens,
    Marrella \u2013 after Dr. John Marr, palaeontologist at Cambridge University and
    friend of Walcott, and splendens \u2013 from the Latin splendens, \u201Cbeautiful,
    or brilliant.\u201D [Burgess Shale Virtual Museum]\n\n"
--- !u!222 &749637209
