  m_Script: {fileID: 708705254, guid: f70555f144d8491a825f0804e09c671c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
    m_TypeName: UnityEngine.UI.MaskableGraphic+CullStateChangedEvent, UnityEngine.UI,
      Version=1.0.0.0, Culture=neutral, PublicKeyToken=null
  m_FontData:
    m_Font: {fileID: 12800000, guid: 1661911a063af41dd9de29a01f7f9457, type: 3}
    m_FontSize: 50
    m_FontStyle: 0
    m_BestFit: 1
    m_MinSize: 0
    m_MaxSize: 50
    m_Alignment: 1
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "Wandering onto the flat mud and sand outcroppings, we find more life. \n\nTrilobites,
    primitive arthropod creatures, scurry over the sea floor, scavenging for food.
    Trilobites were the most dominant type of organism that lived during the Cambrian,
    multitudes of species occupying their own ecological niches.\n\nBut although they
    were the most dominant creature to live during this time, every organism has its
    time, and it's fall. Today, the trilobite, and all known relatives, are extinct. "
