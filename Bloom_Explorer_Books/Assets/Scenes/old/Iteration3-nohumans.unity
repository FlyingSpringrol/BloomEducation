    m_TypeName: UnityEngine.UI.MaskableGraphic+CullStateChangedEvent, UnityEngine.UI,
      Version=1.0.0.0, Culture=neutral, PublicKeyToken=null
  m_FontData:
    m_Font: {fileID: 12800000, guid: 1661911a063af41dd9de29a01f7f9457, type: 3}
    m_FontSize: 50
    m_FontStyle: 0
    m_BestFit: 1
    m_MinSize: 0
    m_MaxSize: 50
    m_Alignment: 1
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: 'The largest, and most fearsome predator during the Cambrian was Anomalocaris.
    It was an athropod like creature that swam using its side fins, grabbing it''s
    prey with it''s evolved mouth parts and slurping them up with it''s circular mouth
    hole.


    Fortunately for it''s prey, they wouldn''t meet their death in the jaws of the
    Anomalocaris: the ''jaw'' body structure wouldn''t evolve for at least a couple
    million years. It''s prey would just be torn apart and vacuumed up instead. You
    win some you lose some.'
--- !u!222 &753489488
