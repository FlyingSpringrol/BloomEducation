  m_FontData:
    m_Font: {fileID: 12800000, guid: 343c661744dab4dafbb924590bb89126, type: 3}
    m_FontSize: 16
    m_FontStyle: 0
    m_BestFit: 1
    m_MinSize: 0
    m_MaxSize: 50
    m_Alignment: 1
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "During mummification, the organs of the deceased were removed by a priest
    and placed into Canopic jars. \n\nThe baboon headed god would protect the lungs,
    the jackal headed god would protect the the stomach, the human headed god would
    protect the liver, and the falcon headed god would protect the intestines.\nThe
    heart was left in the body, to be weighed in the afterlife in the Hall of Truth."
