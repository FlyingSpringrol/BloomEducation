  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 343c661744dab4dafbb924590bb89126, type: 3}
    m_FontSize: 16
    m_FontStyle: 0
    m_BestFit: 1
    m_MinSize: 0
    m_MaxSize: 50
    m_Alignment: 1
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "Thoth was the god of wisdom, revered by scribes and the upper class. Thoth
    was depicted with the head of the sacred ibis. \n\nOver the 3,000 years in which
    this book takes place, Thoth changed over time: Thoth went from a moon god, to
    a wisdom god, to a fusion of the two. While these changes seem odd, think about
    how long 1,000 years is. Think about how much humans beliefs about the world
    have changed since just 1,000 CE, which was the era of Medieval Europe. "
